# Shopify Catalog API (Dev Dashboard)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Saved catalogs
SHOPIFY_CATALOG_ID=01m12qne33qw184bkw337397hj
# Phase 2: catalog with ships_from CA only (no locked ships_to)
SHOPIFY_CATALOG_ID_EXPORT=

# Public site URL for Catalog agent profile (optional on Vercel — auto-detected from VERCEL_URL)
# Local:
PUBLIC_BASE_URL=http://localhost:3000
# Vercel manual override (Plain text only — not Secret). Prefer SITE_BASE_URL if PUBLIC_ causes UI issues:
# SITE_BASE_URL=https://your-project.vercel.app

# Agent profile URL sent to Catalog MCP (use shopify.dev sample if localhost)
# SHOPIFY_AGENT_PROFILE_URL=https://shopify.dev/ucp/agent-profiles/2026-04-08/valid-with-capabilities.json

# Default search query prefix
CATALOG_QUERY=made in Canada

# Outbound link tagging — update at go-live
UTM_SOURCE=buy-canadian

PORT=3000
