SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Saved catalogs
SHOPIFY_CATALOG_ID=01m12qne33qw184bkw337397hj
# Phase 2: catalog with ships_from CA only (no locked ships_to)
